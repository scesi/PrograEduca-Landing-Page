        <pre class="console__body" aria-label="Código de ejemplo con los datos del evento"><span class="k">def</span> aprender():
    <span class="k">return</span> [<span class="s">"progra"</span>, <span class="s">"educa"</span>]

evento = {"{"}
    <span class="s">"edicion"</span>: <span class="n">3</span>,
