      <div class="agenda glass-stage"><span class="orb orb--gold agenda__orb-a" aria-hidden="true" style="--s: 240px"></span><span class="orb orb--mint agenda__orb-b" aria-hidden="true" style="--s: 220px"></span>
        <ol class="sched" data-timeline data-day="2026-11-27">
          {programa.map((p) => {
            const hora = p.soloInicio ? hhmm(p.desde) : `${hhmm(p.desde)} – ${hhmm(p.hasta)}`;
            return (
              <li class="sched__row" style={`--c: ${p.color}`} data-from={hhmm(p.desde)} data-to={hhmm(p.hasta)}>
                <time class="sched__time">{hora}</time>
                {p.actividades ? (
                  <div class="sched__body">
                    <div class="sched__item sched__item--group glass">
                      <time class="sched__intime">{hora}</time>
                      <strong>{p.nombre}</strong>
                      <span class="sched__sub">4.º a 6.º de secundaria · {COMUNIDADES.length} actividades simultáneas</span>
                    </div>
                    <ul class="sched__tracks carousel" data-carousel data-carousel-nodots aria-label="Actividades para colegios">
                      {COMUNIDADES.map((c) => (
                        <li class="track glass">
                          <img class="logo-disc" src={c.logo} alt="" width="40" height="40" loading="lazy" decoding="async" />
                          <strong>{c.actividad}</strong>
                          <a class="track__by" href={`#comunidad-${slug(c.nombre)}`}>{c.nombre}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ) : (
                  <div class="sched__body"><div class="sched__item glass"><strong>{p.nombre}</strong></div></div>
                )}
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>
  </div>
  <div class="ejes-tramo__pista" aria-hidden="true"></div>
  </div>

  <section class="section" id="ubicacion" aria-labelledby="ubicacion-h">
