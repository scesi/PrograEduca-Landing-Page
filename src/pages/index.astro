<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // iOS Safari solo aplica :active si hay un listener de toque
  document.addEventListener('touchstart', () => {}, { passive: true });

  // nav: fondo al hacer scroll y sección actual
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const onScroll = () => nav.classList.toggle('is-scrolled', scrollY > 24);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.nav__links a, .nav__menu a')];
  const io = new IntersectionObserver((entries) => {
    // secciones que se agrupan bajo un mismo enlace
    const grupo: Record<string, string> = { ejes: 'evento' };
    const dropBtn = document.querySelector<HTMLElement>('[data-drop-btn]');
    const enParticipa = ['posters', 'colegios', 'sponsors'];
    for (const e of entries) if (e.isIntersecting) {
      const id = grupo[e.target.id] ?? e.target.id;
      links.forEach((a) => a.setAttribute('aria-current', String(a.hash === '#' + id)));
      dropBtn?.toggleAttribute('data-current', enParticipa.includes(id));
    }
  }, { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('main section[id]').forEach((s) => io.observe(s));

  // los ejes en celular fijan un tramo de la página: corrige el destino de un enlace que cae ahí (se define abajo)
  let corregirDestino: ((el: Element, y: number) => number) | null = null;

  // enlaces internos: si la sección cabe en pantalla queda centrada bajo el navbar;
  // si no, su contenido arranca justo debajo del navbar (sin el padding de la sección)
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
    if (!a || a.hash === '#top' || a.hash === '#contenido' || e.defaultPrevented) return;
    const dest = document.getElementById(decodeURIComponent(a.hash.slice(1)));
    if (!dest) return;
    // una sección se mide por su contenido; cualquier otro elemento (p. ej. la tarjeta de una comunidad), por sí mismo
    const box = dest.matches('section') ? dest.querySelector<HTMLElement>(':scope > .wrap') : dest;
    if (!box) return;
    e.preventDefault();
    const track = dest.closest<HTMLElement>('[data-carousel]');
    if (track) track.dispatchEvent(new CustomEvent('carousel:go', { detail: dest }));
    const navH = nav.offsetHeight;
    const r = box.getBoundingClientRect();
    const libre = innerHeight - navH;
    const margen = innerWidth < 721 ? 24 : 32;
    const off = r.height + margen * 2 <= libre ? navH + (libre - r.height) / 2 : navH + margen;
    const y = scrollY + r.top - off;
    scrollTo({ top: corregirDestino ? corregirDestino(box, y) : y, behavior: reduced ? 'auto' : 'smooth' });
  });

  // vibración corta (háptica). Android: Vibration API (necesita que la persona ya haya tocado la página).
  // iPhone no tiene API: en iOS 18+ Safari hace un "tic" al activar un <input switch> a través de su label.
  const haptica = (() => {
    if ('vibrate' in navigator) return () => { try { navigator.vibrate(8); } catch {} };
    const ios = /iP(hone|ad|od)/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    if (!ios) return () => {};
    const label = document.createElement('label');
    label.setAttribute('aria-hidden', 'true');
    label.style.cssText = 'position:fixed;width:1px;height:1px;overflow:hidden;opacity:0;pointer-events:none';
    const input = document.createElement('input');
    input.type = 'checkbox';
    input.setAttribute('switch', '');
    input.tabIndex = -1;
    label.append(input);
    document.body.append(label);
    return () => label.click();
  })();

  // ejes temáticos en celular/tablet: cuando los ejes llegan al centro de la pantalla, evento, ejes y
  // cronograma quedan fijos juntos (un solo bloque sticky con tope negativo) mientras la página recorre
  // una pista vacía debajo. En pantalla no se mueve nada y asoman las secciones vecinas; el avance por
  // la pista elige el eje (cada tercio, uno) y mueve los círculos. Al terminar la pista, todo sigue.
  // El scroll es siempre el del navegador (dedo, rueda, barra, teclado): aquí solo se lee la posición.
  // Si los ejes no caben en pantalla con las vecinas asomando, van apilados; con movimiento reducido
  // también (lo resuelve el CSS).
  const tramo = document.querySelector<HTMLElement>('[data-ejes-tramo]');
  if (tramo) {
    const grupo = tramo.querySelector<HTMLElement>('.ejes-grupo')!;
    const pista = tramo.querySelector<HTMLElement>('.ejes-tramo__pista')!;
    const bloque = tramo.querySelector<HTMLElement>('.ejes-escena__bloque')!;
    const nodos = [...tramo.querySelectorAll<HTMLElement>('.eje-node')];
    const pasos = [...tramo.querySelectorAll<HTMLButtonElement>('.ejes-steps button')];
    const N = nodos.length;
    const enZona = matchMedia('(max-width: 900px)');
    const ASOMA = 24; // px mínimos de las secciones vecinas que deben verse arriba y abajo
    let actual = 0, activo = false, tocando = false, tope = 0;

    const mostrar = (i: number) => {
      if (i === actual) return;
      actual = i;
      nodos.forEach((n, j) => n.classList.toggle('is-active', j === i));
      pasos.forEach((b, j) => { b.classList.toggle('is-active', j === i); b.toggleAttribute('aria-current', j === i); });
      if (tocando) haptica();
    };

    // cuánto bajó el bloque fijo dentro del tramo = cuánto se recorrió la pista (0 a 1)
    const actualizar = () => {
      if (!activo) return;
      const recorrido = grupo.getBoundingClientRect().top - tramo.getBoundingClientRect().top;
      const p = Math.min(Math.max(recorrido / (pista.offsetHeight || 1), 0), 1);
      tramo.style.setProperty('--ep', p.toFixed(4));
      mostrar(Math.min(Math.floor(p * N), N - 1));
    };

    // alto de pantalla estable (sin la barra de Safari): no cambia al desplazarse
    const sonda = document.createElement('div');
    sonda.style.cssText = 'position:fixed;top:0;height:100svh;width:0;visibility:hidden;pointer-events:none';
    document.body.append(sonda);

    let altoPantalla = 0;
    const medir = () => {
      altoPantalla = sonda.offsetHeight;
      // se mide con un solo eje a la vista, como se ve fijo
      tramo.classList.remove('is-apilado');
      const navH = nav.offsetHeight, libre = altoPantalla - navH;
      const b = bloque.getBoundingClientRect(), g = grupo.getBoundingClientRect();
      activo = enZona.matches && !reduced && b.height <= libre - 2 * ASOMA;
      tramo.classList.toggle('is-fijo', activo);
      tramo.classList.toggle('is-apilado', !activo);
      if (!activo) return;
      // tope del bloque para que se fije justo cuando el centro de los ejes llega al centro bajo el navbar
      tope = Math.round(navH + libre / 2 - (b.top - g.top + b.height / 2));
      tramo.style.setProperty('--ejes-tope', tope + 'px');
      actualizar();
    };

    // scroll en el que el bloque se fija
    const inicioFijo = () => scrollY + tramo.getBoundingClientRect().top - tope;

    let cuadro = 0;
    addEventListener('scroll', () => {
      if (!activo || cuadro) return;
      cuadro = requestAnimationFrame(() => { cuadro = 0; actualizar(); });
    }, { passive: true });
    addEventListener('touchstart', () => { tocando = true; }, { passive: true });
    addEventListener('touchend', () => { tocando = false; }, { passive: true });
    addEventListener('touchcancel', () => { tocando = false; }, { passive: true });
    // el contenido cambia de alto (fuentes, imágenes, ancho): se vuelve a medir
    new ResizeObserver(medir).observe(grupo);
    // la barra de Safari cambia innerHeight al desplazarse: solo cuenta si cambió el alto estable
    addEventListener('resize', () => { if (sonda.offsetHeight !== altoPantalla) medir(); });
    enZona.addEventListener('change', medir);

    // pestañas (y el foco del teclado): llevan la página al punto de la pista donde se ve ese eje
    const irA = (i: number) => {
      if (!activo) { mostrar(i); return; }
      scrollTo({ top: Math.round(inicioFijo() + ((i + 0.5) / N) * pista.offsetHeight), behavior: reduced ? 'auto' : 'smooth' });
    };
    pasos.forEach((b, i) => b.addEventListener('click', () => irA(i)));
    tramo.addEventListener('focusin', (e) => {
      const i = nodos.findIndex((n) => n.contains(e.target as Node));
      if (i >= 0 && i !== actual) irA(i);
    });

    // un enlace a algo dentro del bloque: lo que está sobre los ejes se alcanza antes de fijarse (los
    // ejes mismos, justo al fijarse); lo que está debajo, después de la pista, nunca a mitad de ella
    corregirDestino = (el, y) => {
      if (!activo || !grupo.contains(el)) return y;
      const r = el.getBoundingClientRect();
      const enBloque = r.top - grupo.getBoundingClientRect().top; // no cambia al fijarse
      const enPantalla = scrollY + r.top - y; // altura de la pantalla donde debe quedar
      const inicioTramo = scrollY + tramo.getBoundingClientRect().top;
      if (enPantalla - enBloque >= tope - 40) return Math.min(inicioTramo + enBloque - enPantalla, inicioFijo());
      return inicioTramo + pista.offsetHeight + enBloque - enPantalla;
    };

    pasos[0]?.setAttribute('aria-current', 'true');
    medir();
  }

  // pósters: pasada la fecha límite, el botón se reemplaza por el aviso de cierre (?fase=post también lo muestra)
  document.querySelectorAll<HTMLElement>('[data-hasta]').forEach((el) => {
    const forzado = new URLSearchParams(location.search).get('fase') === 'post';
    if (forzado || Date.now() >= new Date(el.dataset.hasta!).getTime()) {
      el.hidden = true;
      el.parentElement?.querySelector<HTMLElement>('[data-cerrado]')?.removeAttribute('hidden');
    }
  });

  // escalera de colegios: se enciende al entrar en pantalla
  const escalera = document.querySelector<HTMLElement>('.escalera');
  if (escalera && 'IntersectionObserver' in window) {
    new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { escalera.classList.add('is-in'); o.disconnect(); } }, { rootMargin: '0px 0px -20% 0px' }).observe(escalera);
  }

  // carruseles del celular (speakers y comunidades): infinitos y centrados, con arrastre de mouse y puntos.
  // Para el bucle se clona la lista antes y después; al quedar quieto sobre una copia,
  // se salta sin animación a la tarjeta original equivalente.
  const movil = matchMedia('(max-width: 720px)');
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((track) => {
    const items = [...track.children] as HTMLElement[];
    const n = items.length;
    const copia = () => items.map((it) => {
      const c = it.cloneNode(true) as HTMLElement;
      c.dataset.clone = '';
      c.removeAttribute('id');
      c.setAttribute('aria-hidden', 'true');
      c.querySelectorAll('a, button').forEach((el) => el.setAttribute('tabindex', '-1'));
      return c;
    });
    // las copias existen solo en el celular; en escritorio la grilla muestra cada tarjeta una vez
    const ponerCopias = () => { if (!track.querySelector('[data-clone]')) { track.prepend(...copia()); track.append(...copia()); } };
    const quitarCopias = () => track.querySelectorAll('[data-clone]').forEach((c) => c.remove());
    const all = () => [...track.children] as HTMLElement[];
    const instant = 'instant' as ScrollBehavior;

    // distancia para dejar una tarjeta en el centro del carrusel
    const centro = (el: HTMLElement) => {
      const r = el.getBoundingClientRect(), t = track.getBoundingClientRect();
      return r.left + r.width / 2 - (t.left + t.width / 2);
    };
    const ir = (el: HTMLElement, smooth = true) => track.scrollTo({ left: track.scrollLeft + centro(el), behavior: smooth && !reduced ? 'smooth' : instant });

    const dots = document.createElement('div');
    dots.className = 'carousel__dots';
    const btns = items.map((it, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', `Ir a ${i + 1} de ${n}`);
      b.addEventListener('click', () => ir(it));
      dots.append(b);
      return b;
    });
    if (!track.hasAttribute('data-carousel-nodots')) track.after(dots);

    const cercano = () => {
      let best = 0, dist = Infinity;
      all().forEach((it, i) => { const d = Math.abs(centro(it)); if (d < dist) { dist = d; best = i; } });
      return best;
    };
    const marcar = () => { const i = track.querySelector('[data-clone]') ? cercano() % n : cercano(); btns.forEach((b, j) => b.toggleAttribute('aria-current', j === i)); };
    const recolocar = () => {
      if (!movil.matches || arrastrando || !track.querySelector('[data-clone]')) return;
      const i = cercano();
      if (i < n || i >= 2 * n) ir(all()[n + (i % n)], false);
    };
    let raf = 0, quieto = 0;
    track.addEventListener('scroll', () => {
      raf ||= requestAnimationFrame(() => { raf = 0; marcar(); });
      clearTimeout(quieto);
      quieto = window.setTimeout(recolocar, 140);
    }, { passive: true });
    // desde un enlace (p. ej. el nombre de la comunidad en el cronograma)
    track.addEventListener('carousel:go', (e) => { if (movil.matches) ir((e as CustomEvent<HTMLElement>).detail, false); });

    // arrastre con mouse (en el celular ya se desliza con el dedo)
    let x0 = 0, s0 = 0, arrastrando = false, movido = false;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || !movil.matches || e.button !== 0) return;
      arrastrando = true; movido = false; x0 = e.clientX; s0 = track.scrollLeft;
    });
    addEventListener('pointermove', (e) => {
      if (!arrastrando) return;
      const dx = e.clientX - x0;
      // solo es arrastre después de moverse: un clic simple abre la tarjeta
      if (!movido && Math.abs(dx) > 5) { movido = true; track.classList.add('is-dragging'); }
      if (movido) track.scrollLeft = s0 - dx;
    });
    addEventListener('pointerup', () => {
      if (!arrastrando) return;
      arrastrando = false;
      if (!movido) return;
      track.classList.remove('is-dragging');
      ir(all()[cercano()]);
    });
    // un arrastre no abre la tarjeta
    track.addEventListener('click', (e) => { if (movido) { e.preventDefault(); e.stopPropagation(); movido = false; } }, true);
    track.addEventListener('dragstart', (e) => e.preventDefault());

    const iniciar = () => {
      if (movil.matches) { ponerCopias(); ir(items[0], false); marcar(); }
      else quitarCopias();
    };
    iniciar();
    movil.addEventListener('change', iniciar);
  });

  // speakers: cada tarjeta abre su ventana con el resumen
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-speaker]');
    if (b) (document.getElementById(b.dataset.speaker!) as HTMLDialogElement | null)?.showModal();
  });
  document.querySelectorAll<HTMLDialogElement>('.speaker-dialog').forEach((d) => {
    d.querySelector('[data-close]')?.addEventListener('click', () => d.close());
    // cerrar al tocar fuera (respaldo para navegadores sin closedby)
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });

  // desplegable "Participa" en la barra de escritorio
  const drop = document.querySelector<HTMLElement>('[data-drop]');
  if (drop) {
    const btn = drop.querySelector<HTMLButtonElement>('[data-drop-btn]')!;
    const panel = drop.querySelector<HTMLElement>('[data-drop-panel]')!;
    const setDrop = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); panel.hidden = !open; drop.classList.toggle('is-open', open); };
    const fino = matchMedia('(hover: hover) and (pointer: fine)').matches;
    // con mouse el clic fija el panel abierto (el hover ya lo abrió); con teclado o táctil alterna
    let fijo = false;
    btn.addEventListener('click', (e) => {
      if (fino && e.detail > 0) { fijo = !fijo; setDrop(fijo); return; }
      fijo = false;
      setDrop(panel.hidden);
    });
    // al salir con Tab, se cierra
    drop.addEventListener('focusout', (e) => { if (!drop.contains(e.relatedTarget as Node)) { fijo = false; setDrop(false); } });
    panel.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) { fijo = false; setDrop(false); } });
    document.addEventListener('click', (e) => { if (!drop.contains(e.target as Node)) { fijo = false; setDrop(false); } });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { fijo = false; setDrop(false); btn.focus(); } });
    if (fino) {
      let t = 0;
      drop.addEventListener('pointerenter', () => { clearTimeout(t); setDrop(true); });
      drop.addEventListener('pointerleave', () => { if (!fijo) t = window.setTimeout(() => setDrop(false), 180); });
    }
  }

  // menú móvil
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const setMenu = (open: boolean) => {
    nav.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu.inert = !open;
  };
  toggle.addEventListener('click', () => setMenu(!nav.classList.contains('is-open')));
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav.classList.contains('is-open')) { setMenu(false); toggle.focus(); }
  });
  document.addEventListener('click', (e) => { if (!nav.contains(e.target as Node)) setMenu(false); });
  matchMedia('(min-width: 961px)').addEventListener('change', (m) => { if (m.matches) setMenu(false); });

  // el código del hero se escribe solo
  const typed = document.querySelector<HTMLElement>('[data-type]');
  const cursor = '<span class="cursor" aria-hidden="true"></span>';
  if (typed && reduced) typed.insertAdjacentHTML('beforeend', cursor);
  if (typed && !reduced) {
    const src = document.createElement('div');
    src.innerHTML = typed.innerHTML;
    const total = src.textContent!.length;
    let n = 0;
    const render = () => {
      let left = n;
      const out = document.createElement('div');
      const walk = (from: Node, to: Node) => {
        for (const c of [...from.childNodes]) {
          if (left <= 0) return;
          if (c.nodeType === Node.TEXT_NODE) {
            const t = c.textContent!.slice(0, left);
            left -= t.length;
            to.appendChild(document.createTextNode(t));
          } else {
            const el = c.cloneNode(false);
            to.appendChild(el);
            walk(c, el);
          }
        }
      };
      walk(src, out);
      typed.innerHTML = out.innerHTML + cursor;
    };
    typed.innerHTML = cursor;
    setTimeout(function tick() {
      n++;
      render();
      if (n < total) setTimeout(tick, 28 + Math.random() * 40);
    }, 900);
  }

  // cuenta regresiva escrita como llamada a función
  const cd = document.querySelector<HTMLElement>('[data-countdown]');
  if (cd) {
    const target = new Date(cd.dataset.countdown!).getTime();
    const end = target + (6 * 60 + 40) * 60e3; // 9:20 a 16:00
    const pad = (x: number) => String(x).padStart(2, '0');
    // ?fase=live|post permite revisar los estados antes del evento
    const forced = new URLSearchParams(location.search).get('fase');
    const now = () => forced === 'live' ? target + 3600e3 : forced === 'post' ? end + 3600e3 : Date.now();
    let phase = '';
    const setPhase = (p: 'pre' | 'live' | 'post') => {
      if (p === phase) return;
      phase = p;
      document.documentElement.dataset.phase = p;
      document.querySelectorAll<HTMLAnchorElement>('[data-cta]').forEach((a) => {
        a.dataset.label ??= a.querySelector('[data-cta-label]')!.textContent!;
        a.querySelector('[data-cta-label]')!.textContent = p === 'live' ? a.dataset.live! : a.dataset.label!;
        a.setAttribute('href', p === 'live' ? '#cronograma' : '#inscripcion');
      });
      document.querySelectorAll<HTMLElement>('[data-pre]:not([data-cta])').forEach((el) => (el.hidden = p === 'post'));
      document.querySelectorAll<HTMLElement>('[data-post]').forEach((el) => (el.hidden = p !== 'post'));
    };
    let timer = 0;
    const update = () => {
      const t = now();
      const ms = target - t;
      if (ms <= 0) {
        if (t < end) {
          setPhase('live');
          cd.innerHTML = '<b>evento.en_curso()</b> · centro MEMI, UMSS';
        } else {
          setPhase('post');
          cd.innerHTML = 'evento.terminado() · gracias por venir';
          clearInterval(timer);
        }
        return;
      }
      setPhase('pre');
      const d = Math.floor(ms / 864e5), h = Math.floor(ms / 36e5) % 24, m = Math.floor(ms / 6e4) % 60, s = Math.floor(ms / 1e3) % 60;
      cd.innerHTML = `faltan(<b>${d}</b> días, <b>${pad(h)}:${pad(m)}:${pad(s)}</b>)`;
    };
    timer = window.setInterval(update, 1000);
    update();
  }

  // consola: Ejecutar dibuja PROGRAEDUCA con pixeles (fuente de 4×5)
  const run = document.querySelector<HTMLButtonElement>('[data-run]');
  const out = document.querySelector<HTMLOutputElement>('[data-out]');
  const art = document.querySelector<HTMLElement>('[data-art]');
  if (run && out && art) {
    const FUENTE: Record<string, string[]> = {
      P: ['1110', '1001', '1110', '1000', '1000'], R: ['1110', '1001', '1110', '1010', '1001'], O: ['0110', '1001', '1001', '1001', '0110'],
      G: ['0111', '1000', '1011', '1001', '0111'], A: ['0110', '1001', '1111', '1001', '1001'], E: ['1111', '1000', '1110', '1000', '1111'],
      D: ['1110', '1001', '1001', '1001', '1110'], U: ['1001', '1001', '1001', '1001', '0110'], C: ['0111', '1000', '1000', '1000', '0111'],
    };
    const COLS = 29; // PROGRA: 6 letras × 4 + 5 espacios
    const palabra = (texto: string, color: string) => {
      const fila = document.createElement('div');
      fila.className = 'pixlogo__word';
      fila.style.setProperty('--c', color);
      for (let r = 0; r < 5; r++) {
        let col = 0;
        [...texto].forEach((letra, i) => {
          if (i) { fila.append(celda(false, col++, r)); }
          for (const bit of FUENTE[letra][r]) fila.append(celda(bit === '1', col++, r));
        });
        while (col < COLS) fila.append(celda(false, col++, r));
      }
      return fila;
    };
    const celda = (on: boolean, col: number, r: number) => {
      const c = document.createElement('i');
      if (on) { c.className = 'on'; c.style.setProperty('--d', `${col * 22 + r * 10}ms`); }
      return c;
    };
    // la matriz apagada se arma al cargar: reserva el espacio y la ventana no salta al ejecutar
    art.replaceChildren(palabra('PROGRA', 'var(--mint)'), palabra('EDUCA', 'var(--gold)'));
    // la salida se escribe mientras los pixeles se encienden, las dos a la vez
    let timer = 0;
    run.addEventListener('click', () => {
      clearTimeout(timer);
      art.classList.remove('is-drawn');
      void art.offsetWidth;
      art.classList.add('is-drawn');
      const msg = "['PROGRA', 'EDUCA']";
      let i = 0;
      out.textContent = '';
      const step = () => {
        out.textContent = msg.slice(0, ++i);
        if (i < msg.length) timer = window.setTimeout(step, reduced ? 0 : 22);
      };
      step();
    });
  }

  // los círculos siguen el puntero, muy suave
  if (!reduced && matchMedia('(pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-drift]').forEach((zone) => {
      zone.addEventListener('pointermove', (e) => {
        const r = zone.getBoundingClientRect();
        zone.style.setProperty('--px', String(((e.clientX - r.left) / r.width - 0.5) * 40));
        zone.style.setProperty('--py', String(((e.clientY - r.top) / r.height - 0.5) * 30));
      });
      zone.addEventListener('pointerleave', () => {
        zone.style.setProperty('--px', '0');
        zone.style.setProperty('--py', '0');
      });
    });
  }

  // programa: marca lo que está pasando el día del evento (hora de Bolivia)
  const tl = document.querySelector<HTMLElement>('[data-timeline]');
  if (tl) {
    const mark = () => {
      const parts = Object.fromEntries(new Intl.DateTimeFormat('en-CA', { timeZone: 'America/La_Paz', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date()).map((p) => [p.type, p.value]));
      const today = `${parts.year}-${parts.month}-${parts.day}`;
      const mins = Number(parts.hour) * 60 + Number(parts.minute);
      tl.querySelectorAll<HTMLElement>('.sched__row').forEach((s) => {
        const [fh, fm] = s.dataset.from!.split(':').map(Number);
        const [th, tm] = s.dataset.to!.split(':').map(Number);
        s.classList.toggle('is-now', today === tl.dataset.day && mins >= fh * 60 + fm && mins < th * 60 + tm);
      });
    };
    mark();
    setInterval(mark, 60e3);
  }
  // círculos, pixeles y líneas aparecen al deslizar; los círculos derivan con el scroll
  if (!reduced && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('reveal-ready');
    const items = [...document.querySelectorAll<HTMLElement>('.orb, .pixel, .rule')].filter((el) => !el.closest('.hero'));
    const groups = new Map<Element, number>();
    const live = new Set<HTMLElement>();
    const ro = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const el = e.target as HTMLElement;
        if (e.isIntersecting) {
          if (!el.classList.contains('is-in')) {
            const zone = el.closest('section') ?? document.body;
            const i = groups.get(zone) ?? 0;
            groups.set(zone, i + 1);
            el.style.setProperty('--rd', `${Math.min(i, 5) * 110}ms`);
            el.classList.add('is-in');
          }
          if (el.classList.contains('orb')) live.add(el);
        } else live.delete(el);
      }
    }, { rootMargin: '0px 0px -12% 0px' });
    items.forEach((el) => ro.observe(el));

    // origen del crecimiento: el lado por donde entra el círculo
    items.filter((el) => el.classList.contains('orb')).forEach((el) => {
      const st = el.style;
      if (st.right && !st.left) st.setProperty('--ox', '100%');
      else if (st.left?.startsWith('-')) st.setProperty('--ox', '0%');
    });

    const orbs = [...document.querySelectorAll<HTMLElement>('.orb')];
    const sy = new Map<HTMLElement, number>();
    let ticking = false;
    const parallax = () => {
      ticking = false;
      const mid = innerHeight / 2;
      for (const el of orbs) {
        if (!el.closest('.hero') && !live.has(el)) continue;
        if (el.closest('.hero')) {
          const next = Math.round(Math.min(scrollY, innerHeight * 1.5) * -0.16 * 10) / 10;
          el.style.setProperty('--sy', String(next));
          continue;
        }
        const cur = sy.get(el) ?? 0;
        const r = el.getBoundingClientRect();
        const off = r.top - cur + r.height / 2 - mid;
        const speed = el.closest('.glass-stage') ? 0.1 : 0.08;
        const next = Math.round(-off * speed * 10) / 10;
        sy.set(el, next);
        el.style.setProperty('--sy', String(next));
      }
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(parallax); } }, { passive: true });
    parallax();
  }
</script>
</body>
</html>
