---
import '../styles/global.css';
import { FORMS, CONTACTO, LUGAR_MAPA, LUGAR_MAPA_EMBED, INICIO_EVENTO } from '../config';

const titulo = 'PrograEduca 2026: charlas STEM y feria de pósters en la UMSS';
const descripcion =
  'La programación como herramienta transversal. Tercera versión de PrograEduca, viernes 27 de noviembre en el centro MEMI de la Facultad de Tecnología, UMSS, Cochabamba.';
const tel = (n: string) => 'tel:' + n.replace(/\s+/g, '');
const embed = (url: string) => url + (url.includes('?') ? '&' : '?') + 'embedded=true';

// Programa: posición en la línea de tiempo de 9:00 a 17:30
const DIA_INI = 9 * 60, DIA_FIN = 17 * 60 + 30;
const pct = (h: number, m: number) => (((h * 60 + m) - DIA_INI) / (DIA_FIN - DIA_INI)) * 100;
const programa = [
  { nombre: 'Charlas', desde: [9, 30], hasta: [12, 0], color: 'var(--mint)' },
  { nombre: 'Feria de pósters científicos', desde: [10, 0], hasta: [12, 0], color: 'var(--gold)' },
  { nombre: 'Actividad para colegios', desde: [14, 30], hasta: [16, 0], color: '#9fd7c0' },
  { nombre: 'Cierre del evento', desde: [17, 0], hasta: [17, 30], color: 'var(--cream)', soloInicio: true },
];
const hhmm = ([h, m]: number[]) => `${h}:${String(m).padStart(2, '0')}`;
const ticks = [9, 10, 11, 12, 13, 14, 15, 16, 17];
const arrow = '<svg class="btn__arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{titulo}</title>
<meta name="description" content={descripcion}>
<meta property="og:type" content="website">
<meta property="og:title" content={titulo}>
<meta property="og:description" content={descripcion}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#17302a">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
<a class="skip" href="#contenido">Saltar al contenido</a>

<header class="nav" data-nav>
  <div class="wrap nav__bar">
    <a class="logo" href="#top" aria-label="PrograEduca 2026, inicio"><span class="mint">Progra</span><span class="gold">Educa</span><small>2026</small></a>
    <nav class="nav__links" aria-label="Principal">
      <a href="#evento">Evento</a>
      <a href="#ejes">Ejes</a>
      <a href="#programa">Programa</a>
      <a href="#speakers">Speakers</a>
      <a href="#posters">Pósters</a>
      <a href="#colegios">Colegios</a>
      <a href="#sponsors">Sponsors</a>
    </nav>
    <a class="btn btn--primary" href="#colegios" data-cta data-live="Programa"><span data-cta-label>Inscribirme</span></a>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú" data-menu-toggle><span></span><span></span></button>
  </div>
  <nav class="nav__menu" id="menu" aria-label="Secciones" data-menu inert>
    <ul class="wrap">
      <li><a href="#evento">Evento</a></li>
      <li><a href="#ejes">Ejes</a></li>
      <li><a href="#programa">Programa</a></li>
      <li><a href="#speakers">Speakers</a></li>
      <li><a href="#posters">Pósters</a></li>
      <li><a href="#colegios">Colegios</a></li>
      <li><a href="#sponsors">Sponsors</a></li>
    </ul>
  </nav>
</header>

<main id="contenido">
  <section class="hero" id="top" aria-labelledby="hero-h" data-drift>
    <div aria-hidden="true">
      <span class="orb orb--mint orb--corner" style="--s: clamp(260px, 32vw, 470px); left: -12%; top: -30%; --depth: -0.6"></span>
      <span class="orb orb--gold" style="--s: clamp(260px, 34vw, 500px); left: 48%; top: -28%; --depth: -0.8"></span>
      <span class="orb orb--teal" style="--s: clamp(260px, 32vw, 480px); right: -12%; top: -12%; --depth: 0.5"></span>
      <span class="orb orb--gold orb--low" style="--s: clamp(260px, 34vw, 500px); left: 4%; bottom: -30%; --depth: 0.7"></span>
      <span class="orb orb--mint orb--low" style="--s: clamp(260px, 32vw, 480px); right: -14%; bottom: -36%; --depth: -0.6"></span>

      <pre class="snippet" style="left: 7.5%; top: calc(var(--nav-h) + 13%)" data-type><span class="k">def</span> aprender():
    <span class="k">return</span> [<span class="s">"progra"</span>,<span class="s">"educa"</span>]
print(aprender())</pre>
      <pre class="snippet snippet--desk" style="right: 8%; bottom: 13%"><span class="k">conocimientos</span> = [<span class="s">"progra"</span>,<span class="s">"educa"</span>]
<span class="k">for</span> idea <span class="k">in</span> conocimientos:
    print(idea)</pre>

      <span class="pixel pixel--desk" style="left: 4%; top: 38%; --t: 5s"></span>
      <span class="pixel pixel--gold pixel--desk" style="left: 6.5%; top: 44%; --p: 14px; --t: 6s; --d: 1s"></span>
      <span class="pixel pixel--desk" style="left: 11%; top: 60%; --p: 18px; --t: 7s; --d: 2s"></span>
      <span class="pixel pixel--gold pixel--m1" style="right: 17%; top: 26%; --t: 5.5s; --d: 0.5s"></span>
      <span class="pixel pixel--m2" style="right: 13%; top: 31%; --p: 18px; --t: 6.5s; --d: 1.5s"></span>
      <span class="pixel pixel--desk" style="right: 15%; top: 56%; --p: 18px; --t: 4.5s; --d: 3s"></span>
      <span class="rule" style="left: 0; top: 64%; --w: 9%; --c: #2a5b4f"></span>
      <span class="rule" style="right: 0; top: 50%; --w: 6%"></span>
      <span class="rule" style="right: 7%; top: 61%; --w: 9%; --c: #2a5b4f"></span>
      <span class="rule" style="left: 6.5%; bottom: 22%; --w: 9%"></span>
    </div>

    <div class="wrap hero__inner">
      <p class="hero__when" data-in style="--i: 0"><span class="when__part">Viernes 27 de noviembre, 9:30</span> <span class="when__sep">·</span> <span class="when__part">Centro MEMI, UMSS</span></p>
      <h1 id="hero-h" class="wordmark" data-in style="--i: 1">
        <span class="wordmark__name"><span class="mint">PROGRA</span><span class="gold">EDUCA</span></span>
        <span class="wordmark__year">2026</span>
      </h1>
      <p class="hero__tagline" data-in style="--i: 2">La <span class="gold">programación</span> como herramienta transversal</p>
      <div class="hero__actions" data-in style="--i: 3">
        <a class="btn btn--primary" href="#colegios" data-cta data-live="Ver el programa"><span data-cta-label>Inscribirme al evento</span> <Fragment set:html={arrow} /></a>
        <a class="btn btn--ghost" href="#programa">Ver el programa</a>
      </div>
      <p class="countdown" data-in style="--i: 4" data-countdown={INICIO_EVENTO}>charlas, feria de pósters y actividad para colegios</p>
    </div>
  </section>

  <section class="section section--deep" id="evento" aria-labelledby="evento-h">
    <span class="orb orb--gold" aria-hidden="true" style="--s: 360px; right: -180px; top: 60px; opacity: .55"></span>
    <span class="pixel" aria-hidden="true" style="left: 3%; bottom: 14%; --t: 6s"></span>
    <div class="wrap split">
      <div class="stack">
        <h2 id="evento-h" class="h2">Tecnología y educación desde <span class="gold">2024</span></h2>
        <p class="lead">PrograEduca conecta la tecnología con la educación mediante <strong>charlas</strong> y una <strong>feria de pósters científicos</strong>. Busca promover el aprendizaje con tecnologías STEM: ciencia, tecnología, ingeniería y matemáticas.</p>
        <p class="lead">Este año llega a su <strong>tercera versión</strong> y, por primera vez, suma una <strong>actividad para colegios</strong>.</p>
      </div>
      <div class="glass-stage"><span class="orb orb--gold" aria-hidden="true" style="--s: 240px; right: -50px; top: -70px"></span><span class="orb orb--mint" aria-hidden="true" style="--s: 200px; left: -60px; bottom: -40px"></span>
      <figure class="console glass" style="margin: 0">
        <div class="console__bar" aria-hidden="true"><i style="--c: var(--mint)"></i><i style="--c: var(--gold)"></i><i style="--c: #4d6e64"></i><span>prograeduca.py</span></div>
        <pre class="console__body" aria-label="Código de ejemplo con los datos del evento">evento = {"{"}
    <span class="s">"edicion"</span>: <span class="n">3</span>,
    <span class="s">"desde"</span>: <span class="n">2024</span>,
    <span class="s">"novedad"</span>: <span class="s">"actividad para colegios"</span>,
{"}"}

<span class="k">def</span> aprender(e):
    anio = e[<span class="s">"desde"</span>] + e[<span class="s">"edicion"</span>] - <span class="n">1</span>
    <span class="k">return</span> <span class="s">f"{"{"}anio{"}"}: {"{"}e['novedad']{"}"}"</span>

print(aprender(evento))</pre>
        <div class="console__run">
          <button class="console__btn" type="button" data-run><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 1.5v9l8-4.5z" fill="currentColor"/></svg>Ejecutar</button>
          <span class="console__prompt"><output class="console__out" data-out aria-live="polite"></output><span class="cursor" aria-hidden="true"></span></span>
        </div>
      </figure>
      </div>
    </div>
  </section>

  <section class="section" id="ejes" aria-labelledby="ejes-h">
    <span class="orb orb--mint" aria-hidden="true" style="--s: 300px; left: -150px; bottom: -120px; opacity: .5"></span>
    <span class="pixel pixel--gold" aria-hidden="true" style="right: 6%; top: 18%; --t: 5s"></span>
    <span class="pixel" aria-hidden="true" style="right: 8%; top: 22%; --p: 12px; --t: 7s; --d: 1s"></span>
    <div class="wrap">
      <h2 id="ejes-h" class="h2">Tres ejes temáticos</h2>
      <p class="lead" style="margin-top: 20px">Cada charla se ubica en uno. Se buscan aplicaciones reales y tendencias.</p>
      <div class="ejes-map glass-stage">
        <span class="orb orb--gold" aria-hidden="true" style="--s: 260px; left: 6%; top: 150px"></span>
        <span class="orb orb--mint" aria-hidden="true" style="--s: 300px; right: 4%; top: 220px"></span>
        <svg class="ejes-map__wires" viewBox="0 0 300 100" preserveAspectRatio="none" aria-hidden="true">
          <g><path d="M50 100 C50 0 250 0 250 100" /><path class="pulse" pathLength="100" d="M50 100 C50 0 250 0 250 100" /></g>
          <g><path d="M50 100 C50 52 150 52 150 100" /><path class="pulse" pathLength="100" d="M50 100 C50 52 150 52 150 100" style="animation-delay: .9s" /></g>
          <g><path d="M250 100 C250 52 150 52 150 100" /><path class="pulse" pathLength="100" d="M250 100 C250 52 150 52 150 100" style="animation-delay: 1.8s" /></g>
        </svg>
        <div class="ejes-map__nodes">
          <article class="eje-node glass">
            <code class="eje-node__id">eje[0]</code>
            <h3>Tecnología en diferentes áreas</h3>
            <p>Inteligencia artificial, ciencia de datos, desarrollo de software, ciberseguridad, redes, IoT, robótica y software libre, entre otras.</p>
            <pre class="eje__code" aria-hidden="true"><span class="k">areas</span> = [<span class="s">"IA"</span>, <span class="s">"datos"</span>,
         <span class="s">"IoT"</span>, <span class="s">"robótica"</span>]<span class="cursor" aria-hidden="true"></span></pre>
          </article>
          <article class="eje-node glass">
            <code class="eje-node__id">eje[1]</code>
            <h3>Educación y tecnología</h3>
            <p>Cómo la tecnología transforma la enseñanza y el aprendizaje: herramientas educativas, STEM en el aula y experiencias de innovación educativa.</p>
            <pre class="eje__code" aria-hidden="true"><span class="k">for</span> estudiante <span class="k">in</span> aula:
    aprender(estudiante)<span class="cursor" aria-hidden="true"></span></pre>
          </article>
          <article class="eje-node glass">
            <code class="eje-node__id">eje[2]</code>
            <h3>Elaboración de pósters científicos</h3>
            <p>Cómo comunicar una investigación de forma visual: estructura de un póster, buenas prácticas de diseño y presentación. Va de la mano con la feria. <a class="link" href="#posters">Postula tu póster</a></p>
            <pre class="eje__code" aria-hidden="true">poster = Poster(
    titulo, resumen)<span class="cursor" aria-hidden="true"></span></pre>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--deep" id="programa" aria-labelledby="programa-h">
    <span class="orb orb--teal" aria-hidden="true" style="--s: 420px; right: -200px; bottom: -220px"></span>
    <div class="wrap">
      <h2 id="programa-h" class="h2">Programa del <span class="mint">27 de noviembre</span></h2>
      <p class="lead" style="margin-top: 20px">Un solo día, de 9:30 a 17:00. La feria de pósters corre en paralelo a las charlas.</p>
      <div class="agenda glass-stage"><span class="orb orb--gold agenda__orb-a" aria-hidden="true" style="--s: 240px"></span><span class="orb orb--mint agenda__orb-b" aria-hidden="true" style="--s: 220px"></span>
        <div class="timeline" data-timeline data-day="2026-11-27">
          <div class="timeline__scale" aria-hidden="true">
            {ticks.map((h) => (<span class="timeline__tick" style={`left: ${pct(h, 0)}%`}><span>{h}:00</span></span>))}
          </div>
          <ol style="list-style: none; margin: 0; padding: 0; display: grid; gap: 14px">
            {programa.map((p) => (
              <li class="slot glass" style={`--start: ${pct(p.desde[0], p.desde[1])}%; --len: ${pct(p.hasta[0], p.hasta[1]) - pct(p.desde[0], p.desde[1])}%; --c: ${p.color}`} data-from={hhmm(p.desde)} data-to={hhmm(p.hasta)}>
                <time>{p.soloInicio ? hhmm(p.desde) : `${hhmm(p.desde)} – ${hhmm(p.hasta)}`}</time>
                <strong>{p.nombre}</strong>
              </li>
            ))}
          </ol>
        </div>
        <div class="venue">
          <dl class="venue__facts">
            <div><dt>Ubicación</dt><dd>Centro MEMI, Facultad de Tecnología, UMSS, Cochabamba</dd></div>
            <div><dt>Público</dt><dd>Estudiantes universitarios, docentes, investigadores y aficionados a la tecnología.</dd></div>
            <a class="btn btn--ghost" href={LUGAR_MAPA} target="_blank" rel="noopener">Abrir en Google Maps <Fragment set:html={arrow} /></a>
          </dl>
          <div class="glass-stage"><span class="orb orb--gold" aria-hidden="true" style="--s: 220px; right: -50px; top: -50px"></span><span class="orb orb--mint" aria-hidden="true" style="--s: 200px; left: -50px; bottom: -40px"></span>
          <figure class="map-window glass">
            <div class="console__bar" aria-hidden="true"><i style="--c: var(--mint)"></i><i style="--c: var(--gold)"></i><i style="--c: #4d6e64"></i><span>ubicacion.map</span></div>
            <iframe src={LUGAR_MAPA_EMBED} title="Mapa: centro MEMI, UMSS, Cochabamba" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
          </figure>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="speakers" aria-labelledby="speakers-h">
    <span class="orb orb--gold" aria-hidden="true" style="--s: 320px; left: -160px; top: -100px; opacity: .6"></span>
    <div class="wrap split">
      <div class="stack">
        <h2 id="speakers-h" class="h2">Postula una <span class="gold">charla</span></h2>
        <ul class="reasons">
          <li>Comparte tu experiencia con estudiantes, docentes e investigadores.</li>
          <li>Da visibilidad a tu trabajo, proyecto o comunidad.</li>
          <li>Conecta con otros profesionales y talento joven.</li>
          <li>Aporta a la educación y a la difusión de la tecnología en Cochabamba.</li>
        </ul>
      </div>
      <div class="glass-stage"><span class="orb orb--mint" aria-hidden="true" style="--s: 230px; left: -60px; top: -50px"></span><span class="orb orb--gold" aria-hidden="true" style="--s: 210px; right: -40px; bottom: -60px"></span>
      <figure class="console glass" style="margin: 0">
        <div class="console__bar" aria-hidden="true"><i style="--c: var(--mint)"></i><i style="--c: var(--gold)"></i><i style="--c: #4d6e64"></i><span>postulacion.py</span></div>
        <pre class="console__body" aria-label="Datos que pide el formulario de postulación"><span class="c"># datos que pide el formulario</span>
postulacion = [
    <span class="s">"nombre"</span>,
    <span class="s">"perfil breve"</span>,
    <span class="s">"título de la charla"</span>,
    <span class="s">"resumen"</span>,
    <span class="s">"eje temático"</span>,
    <span class="s">"duración"</span>,
    <span class="s">"requerimientos técnicos"</span>,
]<span class="cursor" aria-hidden="true"></span></pre>
        <div class="console__run">
          <a class="btn btn--primary" href={FORMS.speakers} target="_blank" rel="noopener" data-pre>Postular mi charla <Fragment set:html={arrow} /></a>
        </div>
      </figure>
      <p class="form-note" data-pre>Google te pedirá iniciar sesión para adjuntar tus archivos.</p>
      </div>
    </div>
  </section>

  <section class="section section--deep" id="posters" aria-labelledby="posters-h">
    <div class="wrap split split--flip">
      <div class="stack">
        <h2 id="posters-h" class="h2">Presenta tu <span class="mint">póster</span></h2>
        <p class="lead">La <strong>feria de pósters científicos</strong> corre de <strong>10:00 a 12:00</strong>, en paralelo a las charlas. Muestra tu investigación o proyecto de forma visual.</p>
        <div class="stack form-action" data-pre>
          <a class="btn btn--primary" href={FORMS.posters} target="_blank" rel="noopener">Postular mi póster <Fragment set:html={arrow} /></a>
          <p class="form-note">Google te pedirá iniciar sesión para adjuntar tus archivos.</p>
        </div>
      </div>
      <div class="glass-stage"><span class="orb orb--gold" aria-hidden="true" style="--s: 220px; right: -50px; top: -60px"></span><span class="orb orb--mint" aria-hidden="true" style="--s: 200px; left: -50px; bottom: -50px"></span>
      <figure class="console glass" style="margin: 0">
        <div class="console__bar" aria-hidden="true"><i style="--c: var(--mint)"></i><i style="--c: var(--gold)"></i><i style="--c: #4d6e64"></i><span>feria.py</span></div>
        <pre class="console__body" aria-label="Datos de la feria de pósters"><span class="c"># feria de pósters científicos</span>
feria = {"{"}
    <span class="s">"dia"</span>: <span class="s">"viernes 27 de noviembre"</span>,
    <span class="s">"hora"</span>: <span class="s">"10:00 a 12:00"</span>,
    <span class="s">"lugar"</span>: <span class="s">"centro MEMI, UMSS"</span>,
{"}"}<span class="cursor" aria-hidden="true"></span></pre>
      </figure>
      </div>
    </div>
  </section>

  <section class="section" id="colegios" aria-labelledby="colegios-h">
    <div class="wrap split" style="align-items: start">
      <div class="stack sticky-text">
        <h2 id="colegios-h" class="h2">Trae a tu <span class="gold">colegio</span></h2>
        <p class="lead">Por primera vez, PrograEduca tiene una <strong>actividad para colegios</strong>: el viernes 27 de noviembre, de <strong>14:30 a 16:00</strong>. Invitamos a estudiantes de <strong>4.º a 6.º de secundaria</strong>.</p>
        <p class="lead" data-pre>Inscribe a tu unidad educativa con este formulario. <a class="link" href={FORMS.colegios} target="_blank" rel="noopener">Abrir en otra pestaña</a></p>
      </div>
      <div class="glass-stage" data-pre><span class="orb orb--gold" aria-hidden="true" style="--s: 260px; left: -70px; top: -60px"></span><span class="orb orb--mint" aria-hidden="true" style="--s: 240px; right: -60px; bottom: -50px"></span>
      <div class="form-window glass">
        <div class="console__bar" aria-hidden="true"><i style="--c: var(--mint)"></i><i style="--c: var(--gold)"></i><i style="--c: #4d6e64"></i><span>colegios.form</span></div>
        <iframe src={embed(FORMS.colegios)} title="Formulario Call for Schools, PrograEduca 2026" loading="lazy">Cargando…</iframe>
      </div>
      </div>
    </div>
  </section>

  <section class="section section--deep" id="sponsors" aria-labelledby="sponsors-h">
    <div class="wrap split" style="align-items: start">
      <div class="stack sticky-text">
        <h2 id="sponsors-h" class="h2">Auspicia <span class="mint">PrograEduca</span></h2>
        <p class="lead">Buscamos aliados que compartan la visión del evento. Tu marca llega a <strong>estudiantes universitarios y de secundaria</strong>, <strong>docentes</strong> y <strong>comunidades tecnológicas</strong> de Cochabamba.</p>
        <p class="lead" data-pre>Déjanos tus datos y te contactamos. <a class="link" href={FORMS.sponsors} target="_blank" rel="noopener">Abrir en otra pestaña</a></p>
        <p class="lead">¿Dudas? Escríbenos a <a class="link" href={'mailto:' + CONTACTO.email}>{CONTACTO.email}</a></p>
      </div>
      <div class="glass-stage" data-pre><span class="orb orb--mint" aria-hidden="true" style="--s: 260px; right: -70px; top: -60px"></span><span class="orb orb--gold" aria-hidden="true" style="--s: 240px; left: -60px; bottom: -50px"></span>
      <div class="form-window glass">
        <div class="console__bar" aria-hidden="true"><i style="--c: var(--mint)"></i><i style="--c: var(--gold)"></i><i style="--c: #4d6e64"></i><span>sponsors.form</span></div>
        <iframe src={embed(FORMS.sponsors)} title="Formulario Call for Sponsors, PrograEduca 2026" loading="lazy">Cargando…</iframe>
      </div>
      </div>
    </div>
  </section>
</main>

<footer>
  <section class="closing" aria-labelledby="close-h" data-drift>
    <div aria-hidden="true">
      <span class="orb orb--gold" style="--s: clamp(260px, 32vw, 460px); left: -6%; bottom: -40%; --depth: 0.6"></span>
      <span class="orb orb--deep" style="--s: clamp(240px, 30vw, 420px); left: 30%; bottom: -46%; --depth: -0.4"></span>
      <span class="orb orb--mint" style="--s: clamp(260px, 32vw, 460px); right: -8%; bottom: -36%; --depth: -0.6"></span>
      <span class="pixel pixel--desk" style="left: 12%; top: 22%; --t: 6s"></span>
      <span class="pixel pixel--gold pixel--desk" style="right: 14%; top: 30%; --t: 5s; --d: 1s"></span>
      <span class="rule" style="left: 0; top: 40%; --w: 8%; --c: #2a5b4f"></span>
    </div>
    <div class="wrap">
      <h2 id="close-h" class="h2"><span class="mint">PROGRA</span><span class="gold">EDUCA</span> <span data-pre>te espera</span><span data-post hidden>gracias por venir</span></h2>
      <p class="closing__line"><span>viernes 27 de noviembre</span><i> · </i><span>9:30 a 17:00</span><i> · </i><span>centro MEMI, UMSS</span></p>
      <a class="btn btn--primary" href="#colegios" data-cta data-live="Ver el programa"><span data-cta-label>Inscribirme al evento</span> <Fragment set:html={arrow} /></a>
      <div class="contact">
        <a href={'mailto:' + CONTACTO.email}>{CONTACTO.email}</a>
        {CONTACTO.telefonos.map((n) => (<a href={tel(n)}>{n}</a>))}
      </div>
    </div>
  </section>
  <div class="orgs">
    <ul class="wrap" aria-label="Organizan">
      <li><img src="/assets/logos/umss.png" alt="Universidad Mayor de San Simón" loading="lazy"></li>
      <li><img src="/assets/logos/ai.png" alt="Organización co-organizadora" loading="lazy"></li>
      <li><img src="/assets/logos/kul.png" alt="KU Leuven" loading="lazy"></li>
      <li><img src="/assets/logos/scesi.png" alt="SCESI UMSS" loading="lazy"></li>
    </ul>
  </div>
  <p class="legal">© 2026 PrograEduca · Organiza SCESI UMSS</p>
</footer>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // nav: fondo al hacer scroll y sección actual
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const onScroll = () => nav.classList.toggle('is-scrolled', scrollY > 24);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.nav__links a, .nav__menu a')];
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) links.forEach((a) => a.setAttribute('aria-current', String(a.hash === '#' + e.target.id)));
  }, { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('main section[id]').forEach((s) => io.observe(s));

  // menú móvil
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const setMenu = (open: boolean) => {
    nav.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu.inert = !open;
  };
  toggle.addEventListener('click', () => setMenu(!nav.classList.contains('is-open')));
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav.classList.contains('is-open')) { setMenu(false); toggle.focus(); }
  });
  document.addEventListener('click', (e) => { if (!nav.contains(e.target as Node)) setMenu(false); });
  matchMedia('(min-width: 1101px)').addEventListener('change', (m) => { if (m.matches) setMenu(false); });

  // el código del hero se escribe solo
  const typed = document.querySelector<HTMLElement>('[data-type]');
  const cursor = '<span class="cursor" aria-hidden="true"></span>';
  if (typed && reduced) typed.insertAdjacentHTML('beforeend', cursor);
  if (typed && !reduced) {
    const src = document.createElement('div');
    src.innerHTML = typed.innerHTML;
    const total = src.textContent!.length;
    let n = 0;
    const render = () => {
      let left = n;
      const out = document.createElement('div');
      const walk = (from: Node, to: Node) => {
        for (const c of [...from.childNodes]) {
          if (left <= 0) return;
          if (c.nodeType === Node.TEXT_NODE) {
            const t = c.textContent!.slice(0, left);
            left -= t.length;
            to.appendChild(document.createTextNode(t));
          } else {
            const el = c.cloneNode(false);
            to.appendChild(el);
            walk(c, el);
          }
        }
      };
      walk(src, out);
      typed.innerHTML = out.innerHTML + cursor;
    };
    typed.innerHTML = cursor;
    setTimeout(function tick() {
      n++;
      render();
      if (n < total) setTimeout(tick, 28 + Math.random() * 40);
    }, 900);
  }

  // cuenta regresiva escrita como llamada a función
  const cd = document.querySelector<HTMLElement>('[data-countdown]');
  if (cd) {
    const target = new Date(cd.dataset.countdown!).getTime();
    const end = target + 7.5 * 3600e3; // 9:30 a 17:00
    const pad = (x: number) => String(x).padStart(2, '0');
    // ?fase=live|post permite revisar los estados antes del evento
    const forced = new URLSearchParams(location.search).get('fase');
    const now = () => forced === 'live' ? target + 3600e3 : forced === 'post' ? end + 3600e3 : Date.now();
    let phase = '';
    const setPhase = (p: 'pre' | 'live' | 'post') => {
      if (p === phase) return;
      phase = p;
      document.documentElement.dataset.phase = p;
      document.querySelectorAll<HTMLAnchorElement>('[data-cta]').forEach((a) => {
        a.dataset.label ??= a.querySelector('[data-cta-label]')!.textContent!;
        a.querySelector('[data-cta-label]')!.textContent = p === 'live' ? a.dataset.live! : a.dataset.label!;
        a.setAttribute('href', p === 'live' ? '#programa' : '#colegios');
      });
      document.querySelectorAll<HTMLElement>('[data-pre]:not([data-cta])').forEach((el) => (el.hidden = p === 'post'));
      document.querySelectorAll<HTMLElement>('[data-post]').forEach((el) => (el.hidden = p !== 'post'));
    };
    let timer = 0;
    const update = () => {
      const t = now();
      const ms = target - t;
      if (ms <= 0) {
        if (t < end) {
          setPhase('live');
          cd.innerHTML = '<b>evento.en_curso()</b> · centro MEMI, UMSS';
        } else {
          setPhase('post');
          cd.innerHTML = 'evento.terminado() · gracias por venir';
          clearInterval(timer);
        }
        return;
      }
      setPhase('pre');
      const d = Math.floor(ms / 864e5), h = Math.floor(ms / 36e5) % 24, m = Math.floor(ms / 6e4) % 60, s = Math.floor(ms / 1e3) % 60;
      cd.innerHTML = `faltan(<b>${d}</b> días, <b>${pad(h)}:${pad(m)}:${pad(s)}</b>)`;
    };
    timer = window.setInterval(update, 1000);
    update();
  }

  // consola: ejecutar print(aprender())
  const run = document.querySelector<HTMLButtonElement>('[data-run]');
  const out = document.querySelector<HTMLOutputElement>('[data-out]');
  if (run && out) {
    run.addEventListener('click', () => {
      const msg = '2026: actividad para colegios';
      let i = 0;
      run.disabled = true;
      out.textContent = '';
      const step = () => {
        out.textContent = msg.slice(0, ++i);
        if (i < msg.length) setTimeout(step, reduced ? 0 : 35);
        else run.disabled = false;
      };
      step();
    });
  }

  // los círculos siguen el puntero, muy suave
  if (!reduced && matchMedia('(pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-drift]').forEach((zone) => {
      zone.addEventListener('pointermove', (e) => {
        const r = zone.getBoundingClientRect();
        zone.style.setProperty('--px', String(((e.clientX - r.left) / r.width - 0.5) * 40));
        zone.style.setProperty('--py', String(((e.clientY - r.top) / r.height - 0.5) * 30));
      });
      zone.addEventListener('pointerleave', () => {
        zone.style.setProperty('--px', '0');
        zone.style.setProperty('--py', '0');
      });
    });
  }

  // programa: marca lo que está pasando el día del evento (hora de Bolivia)
  const tl = document.querySelector<HTMLElement>('[data-timeline]');
  if (tl) {
    const mark = () => {
      const parts = Object.fromEntries(new Intl.DateTimeFormat('en-CA', { timeZone: 'America/La_Paz', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date()).map((p) => [p.type, p.value]));
      const today = `${parts.year}-${parts.month}-${parts.day}`;
      const mins = Number(parts.hour) * 60 + Number(parts.minute);
      tl.querySelectorAll<HTMLElement>('.slot').forEach((s) => {
        const [fh, fm] = s.dataset.from!.split(':').map(Number);
        const [th, tm] = s.dataset.to!.split(':').map(Number);
        s.classList.toggle('is-now', today === tl.dataset.day && mins >= fh * 60 + fm && mins < th * 60 + tm);
      });
    };
    mark();
    setInterval(mark, 60e3);
  }
  // círculos, pixeles y líneas aparecen al deslizar; los círculos derivan con el scroll
  if (!reduced && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('reveal-ready');
    const items = [...document.querySelectorAll<HTMLElement>('.orb, .pixel, .rule')].filter((el) => !el.closest('.hero'));
    const groups = new Map<Element, number>();
    const live = new Set<HTMLElement>();
    const ro = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const el = e.target as HTMLElement;
        if (e.isIntersecting) {
          if (!el.classList.contains('is-in')) {
            const zone = el.closest('section') ?? document.body;
            const i = groups.get(zone) ?? 0;
            groups.set(zone, i + 1);
            el.style.setProperty('--rd', `${Math.min(i, 5) * 110}ms`);
            el.classList.add('is-in');
          }
          if (el.classList.contains('orb')) live.add(el);
        } else live.delete(el);
      }
    }, { rootMargin: '0px 0px -12% 0px' });
    items.forEach((el) => ro.observe(el));

    // origen del crecimiento: el lado por donde entra el círculo
    items.filter((el) => el.classList.contains('orb')).forEach((el) => {
      const st = el.style;
      if (st.right && !st.left) st.setProperty('--ox', '100%');
      else if (st.left?.startsWith('-')) st.setProperty('--ox', '0%');
    });

    const orbs = [...document.querySelectorAll<HTMLElement>('.orb')];
    const sy = new Map<HTMLElement, number>();
    let ticking = false;
    const parallax = () => {
      ticking = false;
      const mid = innerHeight / 2;
      for (const el of orbs) {
        if (!el.closest('.hero') && !live.has(el)) continue;
        if (el.closest('.hero')) {
          const next = Math.round(Math.min(scrollY, innerHeight * 1.5) * -0.16 * 10) / 10;
          el.style.setProperty('--sy', String(next));
          continue;
        }
        const cur = sy.get(el) ?? 0;
        const r = el.getBoundingClientRect();
        const off = r.top - cur + r.height / 2 - mid;
        const speed = el.closest('.glass-stage') ? 0.1 : 0.08;
        const next = Math.round(-off * speed * 10) / 10;
        sy.set(el, next);
        el.style.setProperty('--sy', String(next));
      }
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(parallax); } }, { passive: true });
    parallax();
  }
</script>
</body>
</html>
