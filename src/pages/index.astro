  <section class="section" id="speakers" aria-labelledby="speakers-h">
    <div class="wrap speakers">
      <div class="stack">
        <h2 id="speakers-h" class="h2">Speakers <span class="gold">2026</span></h2>
        <p class="lead">Estudiantes, docentes e investigadores que comparten sus proyectos y lo que aprendieron en el camino.</p>
      </div>
      {SPEAKERS.length > 0 ? (
        <>
        <div class="glass-stage speakers__stage"><span class="orb orb--gold" aria-hidden="true" style="--s: 320px; left: 14%; top: 8%"></span><span class="orb orb--mint" aria-hidden="true" style="--s: 360px; right: 6%; top: 34%"></span><span class="orb orb--gold" aria-hidden="true" style="--s: 260px; left: 34%; bottom: -40px"></span>
        <ul class="speakers__grid carousel" data-carousel aria-label="Speakers">
          {SPEAKERS.map((sp, i) => (
            <li>
              <button class="speaker glass" type="button" data-speaker={`speaker-${i}`} aria-haspopup="dialog">
                <span class="speaker__media">
                  {sp.fotos ? (
                    <span class="speaker__group">{sp.fotos.map((f) => <img src={f} alt="" width="300" height="300" loading="lazy" decoding="async" />)}</span>
                  ) : sp.foto ? (
                    <img src={sp.foto} alt="" width="600" height="600" loading="lazy" decoding="async" />
                  ) : (
                    <span class="speaker__mono" aria-hidden="true">{(() => { const m = monograma(sp.nombres[0]); return (
                      <svg viewBox={`-1 -1 ${m.ancho * 10 + 2} 52`} width={m.ancho * 10} height="50">{m.celdas.map((c) => <rect x={c.x * 10} y={c.y * 10} width="8" height="8" class={c.on ? (c.c ? 'on on--gold' : 'on') : 'off'} />)}</svg>
                    ); })()}</span>
                  )}
                </span>
                <span class="speaker__info">
                  <span class="speaker__name">{sp.corto ?? sp.nombres[0]}</span>
