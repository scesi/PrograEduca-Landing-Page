---
import { INSCRIPCION_FORM_URL, SPEAKERS_FORM_URL, CONTACTO, LUGAR_MAPA } from '../config';

const titulo = 'PrograEduca 2026: charlas STEM y feria de pósters en la UMSS';
const descripcion =
  'Tercera versión de PrograEduca, el viernes 27 de noviembre en el centro MEMI de la Facultad de Tecnología, UMSS, Cochabamba.';
const tel = (n: string) => 'tel:' + n.replace(/\s+/g, '');
const embed = INSCRIPCION_FORM_URL
  ? INSCRIPCION_FORM_URL.includes('embedded=true')
    ? INSCRIPCION_FORM_URL
    : INSCRIPCION_FORM_URL + (INSCRIPCION_FORM_URL.includes('?') ? '&' : '?') + 'embedded=true'
  : '';
const arrow = `<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg>`;
---
<!doctype html>
<html lang="es" data-type="service" data-radius="soft" data-buttons="arrow" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{titulo}</title>
<meta name="description" content={descripcion}>
<meta property="og:type" content="website">
<meta property="og:title" content={titulo}>
<meta property="og:description" content={descripcion}>
<meta property="og:image" content="/share.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#f3f6f2">
<!-- <link rel="canonical" href="https://[dominio del evento]/"> -->
<meta name="site-kind" content="other">
<meta name="page-type" content="service">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400..700&family=Red+Hat+Text:wght@400..600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<style is:inline>
:root {
  --p-bg: #f3f6f2; --p-surface: #e4ece6; --p-ink: #14302a; --p-muted: #4f6660;
  --p-accent: #1d4a3e; --p-accent-ink: #f3f6f2; --p-action: #1d4a3e; --p-action-ink: #f3f6f2;
  --p-inv-bg: #14302a; --p-inv-surface: #223c36; --p-inv-ink: #f3f6f2; --p-inv-muted: #98a5a0;
  --p-inv-accent: #f3f6f2; --p-inv-accent-ink: #14302a; --p-inv-action: #f3f6f2; --p-inv-action-ink: #14302a;
  --font-display: "Red Hat Display", system-ui, sans-serif;
  --font-text: "Red Hat Text", system-ui, sans-serif;
  --display-weight: 400;
  --display-tracking: -0.025em;
  --display-tracking-xl: -0.035em;
}
</style>
<script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
<script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
<link rel="modulepreload" href="/assets/moments/moments.js">
<link rel="modulepreload" href="/assets/moments/lib.js">
<link rel="modulepreload" href="/assets/moments/word-highlight/moment.js">
<!-- page CSS: solo lo que va dentro de un visual -->
<style is:inline>
  #ejes .panel { --p-h: 300px; }
  .qr { display: grid; grid-template-columns: 1fr 160px; gap: var(--s-6); align-items: center; }
  .qr img { width: 160px; height: 160px; }
  .form-frame { background: #fff; border-radius: var(--r-lg); overflow: hidden; border: 1px solid var(--line); height: calc(100svh - var(--padt) - var(--padb) - var(--bar)); }
  .form-frame iframe { display: block; width: 100%; height: 100%; border: 0; }
  .orgs { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-6); }
  .orgs img { height: 48px; width: auto; }
  .orgs-block { margin-top: var(--s-9); }
  .form-frame--empty { background: var(--g-alt, var(--p-surface)); display: grid; align-content: center; padding: var(--s-7); }
  @media (max-width: 1023px) { #evento .frame--split { --ratio: 56.25%; } }
  @media (max-width: 639px), (max-width: 1023px) and (max-height: 1100px) { .qr { display: none; } }
  @media (min-width: 640px) and (max-width: 1023px) { #ejes { --h: 2; } }
  @media (max-width: 639px) {
    #ejes .panel { --p-h: 300px; }
    .form-frame { height: 400px; }
    .orgs img { height: 36px; }
  }
</style>
</head>
<body>
<!-- type: service (evento universitario de un día; site-kind other)
     deal: hero photo (re-dealt from film: no film), nav nav-mega, close close-type (re-dealt from close-photo: no unused photograph left),
           footer footer-visit, rhythm space, buttons arrow, mark dots
     palette: colores de la marca (start.mjs brand): fondo verde muy claro, tinta y acento verde oscuro del arte del evento
     type: red-hat (primero repartido; sustituto Google de Telegraf, la fuente del PDF)
     moments: word-highlight en #frase -->
<header class="nav">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Saltar al contenido</a>
    <a class="nav__logo" href="#top"><span class="mark" data-mark="dots" aria-hidden="true"></span>PrograEduca</a>
    <nav class="nav__links" aria-label="Principal">
      <div class="nav__item">
        <a class="nav__link" href="#evento">Evento <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <div class="nav__menu">
          <div class="wrap grid">
            <div class="menu-col span-3">
              <p class="t-label">El evento</p>
              <a href="#evento">PrograEduca<span>Charlas y feria desde 2024</span></a>
              <a href="#ejes">Ejes temáticos<span>Los tres temas de 2026</span></a>
            </div>
            <div class="menu-col span-3">
              <p class="t-label">El día</p>
              <a href="#programa">Programa<span>De 9:30 a 17:00</span></a>
              <a href="#inscripcion">Inscripción<span>Formulario para asistentes</span></a>
            </div>
            <a class="menu-card span-3 start-10" href="#speakers">
              <div class="panel"><img class="frame__img" src="/assets/img/mentoria-640.jpg" alt="Dos personas revisan un trabajo frente a una laptop" loading="lazy" data-source="client" data-subject="personas trabajando con una laptop"></div>
              <span class="t-card">Postula una charla</span>
              <span class="t-small muted">Formulario de speakers abierto</span>
            </a>
          </div>
        </div>
      </div>
      <div class="nav__item"><a class="nav__link" href="#ejes">Ejes</a></div>
      <div class="nav__item"><a class="nav__link" href="#programa">Programa</a></div>
      <div class="nav__item"><a class="nav__link" href="#speakers">Speakers</a></div>
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href="#inscripcion">Inscribirme al evento</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menú">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<main id="top">
  <section class="hero hero--photo" data-enter data-calm="left" aria-labelledby="hero-h">
    <picture class="hero__bg" style="--ly-pos: 70% 50%; --ly-pos-phone: 50% 50%">
      <source media="(max-width: 639px)" srcset="/assets/img/hero-revision-phone.jpg" width="900" height="818">
      <img src="/assets/img/hero-revision.jpg" srcset="/assets/img/hero-revision-1400.jpg 1400w, /assets/img/hero-revision.jpg 2189w" sizes="100vw" width="2189" height="1460" alt="Dos personas revisan un proyecto en una laptop junto a una ventana" fetchpriority="high" data-source="client" data-subject="dos personas revisando un proyecto">
    </picture>
    <div class="wrap"><div class="hero-text">
      <div class="hero__text">
        <p class="hero-notice">PrograEduca 2026 · viernes 27 de noviembre</p>
        <h1 id="hero-h">Charlas STEM y feria de pósters</h1>
        <p class="hero__lead">Tercera versión, en el centro MEMI de la Facultad de Tecnología, UMSS. Por primera vez con una actividad para colegios.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="#inscripcion">Inscribirme al evento<Fragment set:html={arrow} /></a>
          <a class="btn btn--secondary" href="#speakers">Postular una charla</a>
        </div>
      </div>
    </div></div>
  </section>

  <section class="section" id="evento" aria-labelledby="evento-h">
    <div class="wrap">
      <div class="grid">
        <div class="span-5 stack-6">
          <h2 id="evento-h">Tecnología y educación desde 2024</h2>
          <p class="t-lead">Charlas y una feria de pósters científicos para aprender con tecnologías STEM: ciencia, tecnología, ingeniería y matemáticas.</p>
          <ul class="rows">
            <li><span class="rows__name">Edición</span><span class="rows__value">Tercera, en 2026</span></li>
            <li><span class="rows__name">Novedad</span><span class="rows__value">Actividad para colegios</span></li>
            <li><span class="rows__name">Ciudad</span><span class="rows__value">Cochabamba</span></li>
          </ul>
          <p><a class="link" href="#programa">Ver el programa</a></p>
        </div>
        <div class="frame frame--split frame--photo span-6 start-7">
          <img class="frame__img" src="/assets/img/mentoria.jpg" width="1280" height="853" alt="Un docente explica algo a una estudiante sentada frente a su laptop" loading="lazy" data-source="client" data-subject="docente y estudiante con una laptop">
        </div>
      </div>
    </div>
  </section>

  <section class="section statement" id="frase" data-moment="word-highlight" aria-label="El lema de 2026">
    <div class="wrap">
      <p class="t-label">El lema de 2026</p>
      <p class="mo-wh__text">La programación como <strong>herramienta transversal</strong>: charlas de inteligencia artificial, robótica y educación, una feria de pósters científicos y, por primera vez, una actividad para colegios, todo en un solo día en la UMSS.</p>
    </div>
  </section>

  <section class="section" id="ejes" style="--hm: 2" aria-labelledby="ejes-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="ejes-h">Tres ejes temáticos. <span class="muted">Cada charla elige uno.</span></h2>
      </div>
      <div class="grid">
        <article class="card card--row card--open span-4">
          <h3>Tecnología en diferentes áreas</h3>
          <p>Inteligencia artificial, ciencia de datos, software, ciberseguridad, redes, IoT, robótica y software libre, con aplicaciones reales y tendencias.</p>
          <div class="panel"><img class="frame__img" src="/assets/img/eje-tecnologia.jpg" width="1047" height="698" alt="Un equipo conversa alrededor de una mesa con laptops" loading="lazy" data-source="client" data-subject="equipo trabajando en una mesa"></div>
        </article>
        <article class="card card--row card--open span-4">
          <h3>Educación y tecnología</h3>
          <p>Cómo la tecnología cambia la enseñanza: herramientas educativas, STEM en el aula y experiencias de innovación educativa.</p>
          <div class="panel"><img class="frame__img" src="/assets/img/eje-educacion.jpg" width="800" height="1200" alt="Tres personas miran juntas la pantalla de una laptop" style="object-position: 50% 30%" loading="lazy" data-source="client" data-subject="tres personas frente a una laptop"></div>
        </article>
        <article class="card card--row card--open span-4">
          <h3>Pósters científicos STEM</h3>
          <p>Cómo comunicar una investigación en un póster: estructura, diseño y presentación, junto a la feria que corre en paralelo.</p>
          <div class="panel"><img class="frame__img" src="/assets/img/eje-posters.jpg" width="800" height="1200" alt="Una mano escribe notas en un cuaderno" style="object-position: 50% 40%" loading="lazy" data-source="client" data-subject="mano escribiendo en un cuaderno"></div>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="programa" aria-labelledby="programa-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="programa-h">Programa del viernes 27 de noviembre</h2>
        <p>Cuatro momentos entre las 9:30 y las 17:00. La feria de pósters corre en paralelo a las charlas.</p>
      </div>
      <div class="grid">
        <ul class="rows span-5">
          <li><span class="rows__name">Charlas</span><span class="rows__value">9:30 a 12:00</span></li>
          <li><span class="rows__name">Feria de pósters científicos</span><span class="rows__value">10:00 a 12:00</span></li>
          <li><span class="rows__name">Actividad para colegios</span><span class="rows__value">14:30 a 16:00</span></li>
          <li><span class="rows__name">Cierre del evento</span><span class="rows__value">17:00</span></li>
        </ul>
        <div class="span-6 start-7 stack-4">
          <p class="t-label">Lugar</p>
          <p class="t-lead">Centro MEMI, Facultad de Tecnología, UMSS, Cochabamba</p>
          <p><a class="link" href={LUGAR_MAPA} target="_blank" rel="noopener">Ver la zona</a></p>
          <p class="t-label">Público</p>
          <p>Estudiantes universitarios, docentes, investigadores y aficionados a la tecnología.</p>
        </div>
      </div>
      <div class="orgs-block stack-4">
        <p class="t-label">Organizan</p>
        <div class="orgs" aria-label="Organizan">
          <img src="/assets/logos/umss.png" alt="Universidad Mayor de San Simón" loading="lazy">
          <img src="/assets/logos/ai.png" alt="Logotipo de organización co-organizadora" loading="lazy">
          <img src="/assets/logos/scesi.png" alt="SCESI UMSS" loading="lazy">
          <img src="/assets/logos/kul.png" alt="KU Leuven" loading="lazy">
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="speakers" aria-labelledby="speakers-h">
    <div class="wrap">
      <div class="grid">
        <div class="span-5 stack-6">
          <h2 id="speakers-h">Postula una charla como speaker</h2>
          <p class="t-lead">Comparte tu experiencia con estudiantes, docentes e investigadores, da visibilidad a tu proyecto o comunidad y conecta con otros profesionales y talento joven de Cochabamba.</p>
          <p><a class="link" href={SPEAKERS_FORM_URL} target="_blank" rel="noopener">Postular una charla</a></p>
        </div>
        <div class="span-6 start-7 stack-6">
          <p class="t-label">Ten listo para el formulario</p>
          <ul class="rows">
            <li><span class="rows__name">Tu nombre y un perfil breve</span></li>
            <li><span class="rows__name">Título y resumen de la charla</span></li>
            <li><span class="rows__name">Eje temático y duración</span></li>
            <li><span class="rows__name">Requerimientos técnicos</span></li>
          </ul>
          <div class="qr">
            <p>Escanea el código desde tu celular o usa el enlace para abrir el formulario de postulación.</p>
            <img src="/assets/img/qr-speakers.svg" width="160" height="160" alt="Código QR del formulario de postulación de speakers" loading="lazy" data-source="client" data-subject="código QR del formulario">
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="inscripcion" aria-labelledby="inscripcion-h">
    <div class="wrap">
      <div class="grid">
        <div class="span-5 stack-6">
          <h2 id="inscripcion-h">Inscripción al evento</h2>
          <p class="t-lead">Llena el formulario para inscribirte a PrograEduca 2026, el viernes 27 de noviembre de 9:30 a 17:00.</p>
          <p>¿Dudas? Escríbenos a <a class="link" href={'mailto:' + CONTACTO.email}>{CONTACTO.email}</a></p>
        </div>
        <div class="span-6 start-7">
          {embed ? (
            <div class="form-frame">
              <iframe src={embed} title="Formulario de inscripción a PrograEduca 2026" loading="lazy">Cargando el formulario…</iframe>
            </div>
          ) : (
            <div class="form-frame form-frame--empty stack-4">
              <p class="t-lead">El formulario abre pronto.</p>
              <p>Mientras tanto, escríbenos y te avisamos cuando abra.</p>
              <div class="btn-row"><a class="btn btn--secondary" href={'mailto:' + CONTACTO.email + '?subject=Inscripci%C3%B3n%20PrograEduca%202026'}>Escribir al equipo</a></div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="footer closing footer--visit" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--type">
      <div class="section-head">
        <h2 id="close-h">Inscríbete a PrograEduca 2026</h2>
        <p class="t-small muted">Viernes 27 de noviembre, de 9:30 a 17:00, en el centro MEMI de la UMSS.</p>
      </div>
      <a class="btn btn--primary btn--xl" href="#inscripcion">Inscribirme al evento<Fragment set:html={arrow} /></a>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-6 stack-4">
          <address class="footer__address">Facultad de Tecnología, UMSS, Cochabamba</address>
          <p><a class="link" href={LUGAR_MAPA} target="_blank" rel="noopener">Ver la zona</a></p>
        </div>
        <div class="span-6 start-7 stack-4">
          <h3>Contacto</h3>
          <p><a class="link" href={'mailto:' + CONTACTO.email}>{CONTACTO.email}</a></p>
          <p>{CONTACTO.telefonos.map((n, i) => (<>{i > 0 && ' · '}<a href={tel(n)}>{n}</a></>))}</p>
        </div>
      </div>
      <div class="footer__legal">
        <span>&copy; 2026 PrograEduca · Organiza SCESI UMSS</span>
      </div>
    </div>
  </div>
</footer>

<nav class="actionbar" aria-label="Acciones rápidas">
  <a class="btn btn--primary" href="#inscripcion">Inscribirme al evento</a>
</nav>
<script is:inline type="module" src="/assets/system.js"></script>
<script is:inline type="module" src="/assets/motion/motion.js"></script>
<script is:inline type="module" src="/assets/layout/layout.js"></script>
</body>
</html>
