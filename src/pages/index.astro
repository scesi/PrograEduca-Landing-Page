---
import '@fontsource/outfit/latin-400.css';
import '@fontsource/outfit/latin-500.css';
import '@fontsource/outfit/latin-600.css';
import '@fontsource/outfit/latin-700.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import outfit700 from '@fontsource/outfit/files/outfit-latin-700-normal.woff2?url';
import '../styles/global.css';
import { FORMS, SPEAKERS, COMUNIDADES, CONTACTO, LUGAR_MAPA, LUGAR_MAPA_EMBED, INICIO_EVENTO } from '../config';

const titulo = 'PrograEduca 2026';
const descripcion =
  'La programación como herramienta transversal. Tercera versión de PrograEduca, viernes 27 de noviembre en el centro MEMI de la Facultad de Tecnología, UMSS, Cochabamba.';
const tel = (n: string) => 'tel:' + n.replace(/\s+/g, '');
const iniciales = (n: string) => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
// monograma de pixeles (fuente de 4×5, la misma idea que el logo de la consola) para speakers sin foto
const PIX: Record<string, string> = {
  A: '0110100111111001 1001', B: '11101001111010011110', C: '01111000100010000111', D: '11101001100110011110', E: '11111000111010001111',
  F: '11111000111010001000', G: '01111000101110010111', H: '10011001111110011001', I: '11100100010001001110', J: '01110010001010100100',
  K: '10011010110010101001', L: '10001000100010001111', M: '10011111111110011001', N: '10011101101110011001', O: '01101001100110010110',
  P: '11101001111010001000', Q: '01101001100110110111', R: '11101001111010101001', S: '01111000011000011110', T: '11110100010001000100',
  U: '10011001100110010110', V: '10011001100101100110', W: '10011001111111111001', X: '10010110011001101001', Y: '10011001011001000100',
  Z: '11110010010010001111',
};
const monograma = (nombre: string) => {
  const letras = [...iniciales(nombre).normalize('NFD').replace(/[\u0300-\u036f]/g, '')].filter((c) => PIX[c]).slice(0, 2);
  const celdas: { x: number; y: number; on: boolean; c: number }[] = [];
  letras.forEach((l, i) => {
    const bits = PIX[l].replace(/ /g, '');
    for (let r = 0; r < 5; r++) for (let k = 0; k < 4; k++) celdas.push({ x: i * 5 + k, y: r, on: bits[r * 4 + k] === '1', c: i });
  });
  return { ancho: letras.length * 5 - 1, celdas };
};

// Cronograma: una fila por horario; la de actividades para colegios se divide en una columna por comunidad
const slug = (t: string) => t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const programa: { nombre: string; desde: number[]; hasta: number[]; color: string; soloInicio?: boolean; actividades?: boolean }[] = [
  { nombre: 'Acreditación y apertura', desde: [9, 0], hasta: [9, 30], color: 'var(--cream)' },
  { nombre: 'Charlas', desde: [9, 30], hasta: [12, 0], color: 'var(--mint)' },
  { nombre: 'Feria de pósters científicos', desde: [12, 0], hasta: [13, 30], color: 'var(--gold)' },
  { nombre: 'Actividades para colegios', desde: [14, 30], hasta: [16, 0], color: '#9fd7c0', actividades: true },
  { nombre: 'Cierre del evento', desde: [16, 0], hasta: [16, 30], color: 'var(--cream)', soloInicio: true },
];
const hhmm = ([h, m]: number[]) => `${h}:${String(m).padStart(2, '0')}`;
const EXT = '<svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
// código de pixeles decorativo para la entrada (no es un QR real)
const qr = Array.from({ length: 81 }, (_, i) => ((i * 7 + (i >> 2) * 3) % 5 < 2) || [0, 1, 2, 9, 11, 18, 19, 20, 6, 7, 8, 15, 17, 24, 25, 26, 54, 55, 56, 63, 65, 72, 73, 74].includes(i));
// escalera de pixeles para colegios: un bloque por curso, cada uno más alto
const cursos = [{ c: '4.º', h: 5 }, { c: '5.º', h: 8 }, { c: '6.º', h: 11 }];
const arrow = '<svg class="btn__arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{titulo}</title>
<meta name="description" content={descripcion}>
<meta property="og:type" content="website">
<meta property="og:title" content={titulo}>
<meta property="og:description" content={descripcion}>
<meta property="og:image" content="/og.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#17302a">
<link rel="preload" href={outfit700} as="font" type="font/woff2" crossorigin>
<script is:inline>
  // al cargar o recargar, siempre desde el inicio: sin #sección en el link ni scroll recordado
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  if (location.hash) history.replaceState(null, '', location.pathname + location.search);
  addEventListener('load', () => scrollTo(0, 0));
</script>
</head>
<body>
